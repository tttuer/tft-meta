RIOT_API_KEY=
DATABASE_URL=postgresql+asyncpg://tft_user:password@localhost:5432/tft_meta
REDIS_URL=redis://localhost:6379
SLACK_WEBHOOK_URL=

# AI API — 둘 중 하나만 설정하면 됨 (GITHUB_TOKEN 우선)
# 1. GitHub Copilot (월 $10, gpt-4o-mini 무제한)
#    발급: https://github.com/settings/tokens → Generate new token (classic) → 스코프 불필요
GITHUB_TOKEN=
GITHUB_COPILOT_MODEL=gpt-4o-mini

# 2. OpenRouter (폴백, 무료 모델은 rate limit 있음)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# K3s 배포 시 아래 값으로 교체됨
